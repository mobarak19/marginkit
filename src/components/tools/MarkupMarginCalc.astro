---
import ShareRow from '../ShareRow.astro';
import CurrencySelect from '../CurrencySelect.astro';
---
<div class="calc" data-calc="markup">
  <form>
    <div class="field">
      <span class="label">I know…</span>
      <div class="seg" role="radiogroup" aria-label="Known values">
        <label><input type="radio" name="mode" value="price" checked /><span>Cost + price</span></label>
        <label><input type="radio" name="mode" value="markup" /><span>Cost + markup</span></label>
        <label><input type="radio" name="mode" value="margin" /><span>Cost + margin</span></label>
      </div>
    </div>
    <div class="row2">
      <div class="field"><label for="mm-cost">Cost</label><input class="input" id="mm-cost" name="cost" type="number" inputmode="decimal" min="0" step="0.01" value="60" /></div>
      <div class="field" data-for="price"><label for="mm-price">Selling price</label><input class="input" id="mm-price" name="price" type="number" inputmode="decimal" min="0" step="0.01" value="100" /></div>
      <div class="field" data-for="markup" hidden><label for="mm-markup">Markup %</label><input class="input" id="mm-markup" name="markup" type="number" min="0" step="1" value="50" /></div>
      <div class="field" data-for="margin" hidden><label for="mm-margin">Margin %</label><input class="input" id="mm-margin" name="margin" type="number" min="0" max="99.9" step="1" value="40" /></div>
    </div>
    <div class="row2"><CurrencySelect id="mm-cur" /></div>
    <ShareRow />
    <p class="note">Markup is profit ÷ cost. Margin is profit ÷ price. The same sale always has a higher markup than margin.</p>
  </form>
  <div class="out" data-out aria-live="polite"></div>
</div>

<script>
  import { mountCalc, num } from '../../app/calc';
  import { priceFromMarkup, priceFromMargin } from '../../lib/profit';
  import { money, pct } from '../../lib/money';

  const root = document.querySelector<HTMLElement>('[data-calc="markup"]')!;
  mountCalc(root, (v) => {
    const f = money(v.cur || 'USD');
    const cost = Math.max(0, num(v.cost));
    const mode = v.mode || 'price';
    const price = mode === 'markup' ? priceFromMarkup(cost, Math.max(0, num(v.markup))) : mode === 'margin' ? priceFromMargin(cost, Math.min(99.9, Math.max(0, num(v.margin)))) : Math.max(0, num(v.price));
    const profit = price - cost;
    const margin = price ? profit / price : 0;
    const markup = cost ? profit / cost : 0;
    const table = [10, 20, 25, 30, 40, 50, 60, 75].map((m) => `<tr><th>${m}% margin = ${pct(m / (100 - m), 1)} markup</th><td>${f(priceFromMargin(cost, m))}</td></tr>`).join('');
    return `<div class="big"><div class="k">${mode === 'price' ? 'Gross margin' : 'Selling price'}</div><div class="v">${mode === 'price' ? pct(margin) : f(price)}</div>
        <div class="s">Markup ${cost ? pct(markup) : '—'} · margin ${pct(margin)} · profit ${f(profit)}</div></div>
      <table class="kv">
        <tr><th>Selling price</th><td>${f(price)}</td></tr>
        <tr><th>Cost</th><td>${f(cost)}</td></tr>
        <tr><th>Gross profit</th><td>${f(profit)}</td></tr>
        <tr><th>Markup (profit ÷ cost)</th><td>${cost ? pct(markup) : '—'}</td></tr>
        <tr><th>Margin (profit ÷ price)</th><td>${pct(margin)}</td></tr>
      </table>
      <table class="kv">${table}</table>`;
  }, (v) => {
    for (const el of root.querySelectorAll<HTMLElement>('[data-for]')) el.hidden = el.dataset.for !== (v.mode || 'price');
  });
</script>
