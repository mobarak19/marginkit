---
// Copy link / copy result / reset buttons handled by mountCalc (src/app/calc.ts).
---
<div class="share-row">
  <button type="button" class="btn btn-sm" data-action="copy-link">Copy link to this result</button>
  <button type="button" class="btn btn-sm" data-action="copy-result">Copy result</button>
  <button type="button" class="btn btn-sm btn-ghost" data-action="reset">Reset</button>
</div>
